---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import bg from '../assets/photos/table-flowers.jpg';
interface Props {
  title?: string;
  body?: string;
  service?: string; // preselects the inquiry form
}
const {
  title = 'Let’s set the table.',
  body = 'Tell us about your celebration and we’ll put together a custom proposal just for you.',
  service,
} = Astro.props;
const href = service ? `/contact/?service=${service}` : '/contact/';
---
<section class="cta on-dark">
  <Image src={bg} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="cta__bg" loading="lazy" />
  <div class="cta__inner wrap reveal">
    <p class="eyebrow">Plan your event</p>
    <h2 class="display">{title}</h2>
    <p class="cta__body">{body}</p>
    <div class="btn-row">
      <a class="btn btn--light" href={href}>Start your inquiry</a>
      <a class="btn btn--ghost-light" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--white);
    padding-block: clamp(6rem, 12vw, 10rem);
    overflow: hidden;
  }
  .cta :global(.cta__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(15 27 45 / 0.9) 0%, rgb(15 27 45 / 0.72) 55%, rgb(15 27 45 / 0.45) 100%);
  }
  .cta__inner {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .cta h2 {
    max-width: 14ch;
  }
  .cta__body {
    max-width: 44ch;
    font-size: var(--step-1);
    color: rgb(255 255 255 / 0.85);
    margin: 0 0 0.6rem;
  }
</style>
