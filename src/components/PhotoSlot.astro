---
// A photo position with a brief attached. With `src`, it shows the current
// (older) photo plus an "update requested" tag; without, it renders a styled
// placeholder describing the shot we need. Tags hide when site.showPhotoNotes is off.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { photoBriefs, type PhotoBriefKey } from '../data/photos';

interface Props {
  brief: PhotoBriefKey;
  src?: ImageMetadata;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  compact?: boolean; // icon + orientation only (e.g. beside the written brief)
}
const { brief: key, src, alt = '', widths = [500, 800, 1200], sizes = '50vw', class: className, compact = false } = Astro.props;
const brief = photoBriefs[key];
const showNote = site.showPhotoNotes;
---
<figure class:list={['slot frame', className, { 'slot--empty': !src }]}>
  {src ? (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} class="cover-img" />
  ) : (
    <div class="slot__ph" role="img" aria-label={`Photo coming soon: ${brief.title}`}>
      <svg class="slot__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M6 15h8l3-5h14l3 5h8v23H6z" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="24" cy="26" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      {showNote && (
        <>
          <span class="slot__eyebrow">Photo needed · {brief.orientation}</span>
          {!compact && <span class="slot__title">{brief.title}</span>}
          {!compact && <span class="slot__shot">{brief.shot}</span>}
        </>
      )}
    </div>
  )}
  {src && showNote && (
    <figcaption class="slot__tag">
      <span class="slot__dot" aria-hidden="true"></span>
      Update requested: {brief.title}
    </figcaption>
  )}
</figure>

<style>
  .slot {
    margin: 0;
    container-type: inline-size;
  }
  .slot__tag {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.45rem 0.8rem;
    background: rgb(15 27 45 / 0.82);
    backdrop-filter: blur(6px);
    color: var(--paper);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .slot__dot {
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--blue);
  }
  .slot__ph {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(1.2rem, 4%, 2.5rem);
    text-align: center;
    color: var(--ink-soft);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(47 95 140 / 0.05) 14px 15px),
      var(--paper-2);
    outline: 1px dashed rgb(47 95 140 / 0.35);
    outline-offset: -0.75rem;
  }
  .slot__icon {
    width: 2.6rem;
    color: var(--blue-deep);
    margin-bottom: 0.3rem;
  }
  .slot__eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }
  .slot__title {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.2;
  }
  .slot__shot {
    font-size: 0.82rem;
    line-height: 1.5;
    max-width: 30ch;
  }
  /* Small slots (e.g. the overlapping square on phones): icon + label only */
  @container (max-width: 280px) {
    .slot__shot { display: none; }
    .slot__title { font-size: 1.05rem; }
    .slot__eyebrow { font-size: 0.56rem; letter-spacing: 0.14em; }
    .slot__icon { width: 2rem; margin: 0; }
    .slot__tag { font-size: 0.58rem; }
  }
  @container (max-width: 200px) {
    .slot__eyebrow { display: none; }
  }
</style>
