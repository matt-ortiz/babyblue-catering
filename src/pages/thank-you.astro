---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Thank You | BabyBlue Modern Catering" description="Thanks for your inquiry. We'll be in touch soon." noindex>
  <section class="section">
    <div class="wrap--narrow" style="text-align:center;display:grid;gap:1.4rem;justify-items:center">
      <p class="eyebrow">Inquiry received</p>
      <h1 class="display">Thank you. <em>We can't wait to cook for you.</em></h1>
      <p class="lead">Chef Jacob will review your details and reach out soon to start planning. Need us sooner? Call <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href="/">Back to home</a>
        <a class="btn btn--ghost" href={site.social.instagram} rel="noopener">Follow on Instagram</a>
      </div>
    </div>
  </section>
</Base>
