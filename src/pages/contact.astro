---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
import side from '../assets/photos/dinner-party-toast.jpg';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---
<Base
  title="Contact & Event Inquiry | BabyBlue Modern Catering, McKinney TX"
  description="Plan your dinner party, wedding, corporate event or private chef experience in McKinney & DFW. Send an inquiry or call BabyBlue Modern Catering today."
  image={side}
  schema={[breadcrumbSchema(crumbs), { '@type': 'ContactPage', name: 'Contact BabyBlue Modern Catering', url: new URL('/contact/', Astro.site).href }]}
>
  <section class="contact">
    <div class="contact__media">
      <Image src={side} alt="Guests raising their wine glasses at a BabyBlue dinner party" widths={[600, 1000, 1400]} sizes="(max-width: 1000px) 100vw, 40vw" class="cover-img" loading="eager" />
      <div class="contact__card on-dark">
        <p class="eyebrow">Talk to Chef Jacob</p>
        <p class="contact__line"><a href={`tel:${site.phoneE164}`}>{site.phone}</a></p>
        <p class="contact__line"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="small">Based in {site.city}, {site.regionName}, serving Collin County &amp; the greater Dallas–Fort Worth area.</p>
      </div>
    </div>
    <div class="contact__form">
      <p class="eyebrow">Plan your event</p>
      <h1 class="display">Let's start with a conversation.</h1>
      <p class="lead">From weddings and corporate events to intimate dinner parties, we'll help with everything from the menu to coordinating your other vendors. Share a few details and we'll be in touch to plan your experience.</p>
      <InquiryForm />
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    min-height: calc(100svh - 5.25rem);
  }
  .contact__media {
    position: relative;
    isolation: isolate;
    min-height: 26rem;
  }
  .contact__media :global(img) {
    position: absolute;
    inset: 0;
  }
  .contact__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(10 18 30 / 0.85), rgb(10 18 30 / 0.1) 60%);
  }
  .contact__card {
    position: absolute;
    left: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    z-index: 1;
    color: var(--white);
    display: grid;
    gap: 0.4rem;
  }
  .contact__line {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .contact__line a {
    text-decoration: none;
  }
  .contact__card .small {
    margin-top: 0.8rem;
    color: rgb(255 255 255 / 0.75);
    max-width: 36ch;
  }
  .contact__form {
    padding: clamp(3rem, 7vw, 6rem) var(--gutter);
    display: grid;
    gap: 1.3rem;
    align-content: start;
    max-width: 52rem;
  }
  .contact__form .lead {
    max-width: 52ch;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 1000px) {
    .contact { grid-template-columns: 1fr; }
  }
</style>
