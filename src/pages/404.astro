---
import { href } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | BabyBlue Modern Catering" description="This page has moved or no longer exists." noindex>
  <section class="section">
    <div class="wrap--narrow" style="text-align:center;display:grid;gap:1.4rem;justify-items:center">
      <p class="eyebrow">404</p>
      <h1 class="display">This course isn't on the menu.</h1>
      <p class="lead">The page you're looking for has moved. Try one of these instead.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href={href('/')}>Home</a>
        <a class="btn btn--ghost" href={href('/in-home-catering/')}>In-home catering</a>
        <a class="btn btn--ghost" href={href('/contact/')}>Contact</a>
      </div>
    </div>
  </section>
</Base>
