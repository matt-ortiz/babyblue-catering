---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { breadcrumbSchema, chefSchema } from '../lib/schema';
import hero from '../assets/photos/in-home-chef-entertaining.jpg';
import portrait from '../assets/photos/chef-jacob-ritenour.jpg';
import family from '../assets/photos/ritenour-family.jpg';
import serving from '../assets/photos/dinner-party-guests.jpg';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
const facts = [
  { k: 'Roots', v: 'A family of restaurateurs & caterers' },
  { k: 'Specialty', v: 'Seasonal cuisine & sushi' },
  { k: 'Est.', v: String(site.foundingYear) },
  { k: 'Home base', v: `${site.city}, ${site.regionName}` },
];
const values = [
  { title: 'Freshness', body: 'Local and seasonal first, with organic meat, dairy and produce whenever possible. Every ingredient is chosen for peak flavor.' },
  { title: 'Accommodation', body: 'Your favorites, your traditions, your dietary needs. Every menu is written for the people at your table.' },
  { title: 'Professionalism', body: 'From your first inquiry to the moment we leave, our team is polished, passionate and attentive.' },
  { title: 'Safety', body: 'Fully insured and certified in food safety and handling, and we treat every standard as non-negotiable.' },
];
const details = ['Careful preparation', 'Timely setup', 'Precise cooking', 'Beautiful presentation', 'Warm service', 'A spotless cleanup'];
---
<Base
  title="About Chef Jacob Ritenour | BabyBlue Modern Catering, McKinney TX"
  description="Meet Chef Jacob Thaller Ritenour, owner of BabyBlue Modern Catering in McKinney, Texas. Raised in a family of restaurateurs, with a passion for fresh, seasonal food and sushi."
  image={hero}
  imageAlt="Chef Jacob cooking at a kitchen island while guests laugh"
  overlayHeader
  schema={[breadcrumbSchema(crumbs), chefSchema()]}
>
  <PageHero
    eyebrow="Our story"
    title="Modern catering, rooted in family."
    lead="BabyBlue exists so that hosts can finally be guests at their own celebrations."
    image={hero}
    imageAlt="Chef Jacob cooking at a kitchen island while guests laugh"
    crumbs={crumbs}
  />

  <!-- BIO -->
  <section class="section">
    <div class="wrap bio">
      <PhotoSlot
        brief="chef-portrait"
        src={portrait}
        alt="Chef Jacob Thaller Ritenour in a kitchen with copper pots"
        widths={[500, 736]}
        sizes="(max-width: 900px) 100vw, 40vw"
        class="bio__portrait reveal"
      />
      <div class="bio__text reveal">
        <p class="eyebrow">Owner &amp; Executive Chef</p>
        <h2 class="h2">Jacob Thaller Ritenour</h2>
        <p class="lead">Jacob was raised in a culinary family that owned restaurants and catering businesses, and he learned early how to plan, prepare and execute events of every size.</p>
        <p>With well over a decade of experience in both the kitchen and business management, he founded BabyBlue Modern Catering to bring restaurant-quality food and genuine hospitality into people's homes and celebrations.</p>
        <blockquote class="bio__quote">
          Let the natural freshness of great ingredients deliver the flavor.
        </blockquote>
        <p>His background is in classic Western cooking and his passion is Asian cuisine, sushi in particular. He brings a clean, modern perspective to every menu he designs, and no two are ever the same.</p>
        <dl class="facts">
          {facts.map((f) => (
            <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we believe</p>
        <h2 class="h2">Our promise to every host</h2>
      </div>
      <div class="values">
        {values.map((v, i) => (
          <div class="reveal">
            <span class="values__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="section">
    <div class="wrap mission">
      <div class="mission__media">
        <PhotoSlot
          brief="team-service"
          src={serving}
          alt="Wine being poured for guests around a BabyBlue dinner party table"
          widths={[600, 900, 1300]}
          sizes="(max-width: 900px) 100vw, 45vw"
          class="mission__a reveal"
        />
        <PhotoSlot brief="chef-hands" class="mission__b reveal" />
      </div>
      <div class="mission__text reveal">
        <p class="eyebrow">Our mission</p>
        <h2 class="h2">An event shared with the people you love, <em>and remembered.</em></h2>
        <p class="lead">We come to you, serve you, and take care of every detail, so your only focus is the people around you.</p>
        <ul class="details">
          {details.map((d) => <li>{d}</li>)}
        </ul>
        <p class="muted">We welcome questions throughout the booking process and encourage open communication. Our goal is to meet your every desire, and to see you again at the next celebration.</p>
      </div>
    </div>
  </section>

  <!-- FAMILY -->
  <section class="section section--sand">
    <div class="wrap family">
      <div class="family__text reveal">
        <p class="eyebrow">Family at the heart of it</p>
        <h2 class="h2">A family business, <em>through and through.</em></h2>
        <p class="lead">BabyBlue grew out of a family of restaurateurs, and family is still why we do this: gathering around a table is where life's best moments happen.</p>
        <p class="muted">When he's not in the kitchen, Jacob plays bass guitar, serves in his community, and, most importantly, spends time with his family.</p>
      </div>
      <PhotoSlot
        brief="family"
        src={family}
        alt="The Ritenour family walking together on a wooded path"
        widths={[400, 576]}
        sizes="(max-width: 900px) 100vw, 45vw"
        class="family__img reveal"
      />
    </div>
  </section>

  <Testimonials />
  <CtaBand />
</Base>

<style>
  /* Bio */
  .bio {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }
  .bio :global(.bio__portrait) {
    aspect-ratio: 4 / 5;
    position: sticky;
    top: 7rem;
  }
  .bio :global(.bio__portrait img) {
    object-position: 62% 40%;
  }
  .bio__text {
    display: grid;
    gap: 1rem;
  }
  .bio__text > p:not(.lead):not(.eyebrow) {
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .bio__quote {
    margin: 1rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--blue);
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 26ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--blue-deep);
    margin-bottom: 0.25rem;
  }
  .facts dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.25;
  }

  /* Values */
  .values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .values > div {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
  .values__n {
    font-family: var(--serif);
    font-style: italic;
    color: var(--blue-deep);
    font-size: 1.2rem;
  }
  .values h3 {
    font-size: var(--step-2);
    margin: 0.5rem 0 0.8rem;
  }
  .values p {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* Mission */
  .mission {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .mission__media {
    position: relative;
    padding-bottom: 16%;
  }
  .mission :global(.mission__a) {
    aspect-ratio: 4 / 3;
    width: 86%;
  }
  .mission :global(.mission__b) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42%;
    aspect-ratio: 1;
    border: 10px solid var(--paper);
  }
  .mission__text {
    display: grid;
    gap: 1.2rem;
  }
  .details {
    list-style: none;
    margin: 0.4rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .details li {
    padding: 0.75rem 0 0.75rem 1.4rem;
    border-bottom: 1px solid var(--line);
    position: relative;
    font-size: 0.95rem;
  }
  .details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35rem;
    width: 0.6rem;
    height: 1px;
    background: var(--blue-deep);
  }

  /* Family */
  .family {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .family__text {
    display: grid;
    gap: 1.2rem;
  }
  .family :global(.family__img) {
    aspect-ratio: 3 / 2;
  }

  @media (max-width: 1000px) {
    .values { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .bio, .mission, .family { grid-template-columns: 1fr; }
    .bio :global(.bio__portrait) { position: relative; top: 0; max-width: 32rem; }
    .family :global(.family__img) { order: -1; }
    .mission :global(.mission__b) { width: 52%; border-width: 6px; }
  }
  @media (max-width: 560px) {
    .values, .facts, .details { grid-template-columns: 1fr; }
  }
</style>
